{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-meets-sdlc",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "sdlcai.org",
      "zone_name": "sdlcai.org",
      "custom_domain": true,
    },
    {
      "pattern": "www.sdlcai.org",
      "zone_name": "sdlcai.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "browser": {
    "binding": "SOCIAL_BROWSER",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      // Keep structured application logs without retaining token-bearing URLs.
      "invocation_logs": false,
      "persist": true,
    },
  },
  "vars": {
    // Poster proposals close at 23:59 EEST on 27 September 2026.
    "POSTER_PROPOSAL_DEADLINE": "2026-09-27T20:59:59Z",
    // Speaker dinner responses close at 23:59 EEST on 5 October 2026.
    "SPEAKER_DINNER_RESPONSE_DEADLINE": "2026-10-05T20:59:59Z",
    // Delete dinner invitations and responses after 26 October 2026.
    "SPEAKER_DINNER_RETENTION_UNTIL": "2026-10-26T21:59:59Z",
    // Public Turnstile site key. Replace this after creating the widget.
    "TURNSTILE_SITE_KEY": "0x4AAAAAADGyYOoRrI5BgaNQ",
    // Hostnames accepted from Turnstile's server-side validation response.
    "TURNSTILE_HOSTNAMES": "sdlcai.org,www.sdlcai.org",
    // Set to "true" only if the legacy registration interest form is needed.
    "SHOW_INTEREST_FORM": "",
  },
  "d1_databases": [
    {
      "binding": "INTERESTS",
      "database_name": "ai-meets-sdlc-interests",
      // Replace after running:
      // wrangler d1 create ai-meets-sdlc-interests
      "database_id": "ec2604ab-f972-40e5-8395-632a58c82d70",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "INTEREST_BACKUPS",
      "bucket_name": "ai-meets-sdlc-interest-backups",
    },
    {
      "binding": "SOCIAL_EXPORTS",
      "bucket_name": "ai-meets-sdlc-social-exports",
    },
  ],
  "triggers": {
    "crons": ["17 2 * * *"],
  },
}
