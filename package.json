{
  "name": "ai-meets-sdlc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:site && npm run event:build && npm run social:manifest",
    "build:site": "gustwind --build --output ./build",
    "build:site:clean": "gustwind --build --output ./build --no-incremental",
    "build:clean": "npm run build:site:clean && npm run event:build && npm run social:manifest",
    "a11y:check": "node scripts/validate-a11y.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ai-meets-sdlc-interests --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-meets-sdlc-interests --remote",
    "dev:env": "node scripts/write-dev-vars.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "interests:decrypt": "node scripts/decrypt-interests.mjs",
    "interests:export": "node scripts/export-interest-contacts.mjs",
    "layout:check": "node scripts/validate-layout.mjs",
    "activity:browser-check": "node scripts/validate-admin-activity.mjs",
    "qa:browser-check": "node scripts/validate-qa.mjs",
    "layout:install-browsers": "playwright install chromium webkit",
    "slides:export": "node scripts/export-slide-assets.mjs",
    "tables:export": "uv run scripts/export-discussion-tables.py",
    "signs:export": "uv run scripts/export-venue-signs.py",
    "slides:export:social": "node scripts/export-social-slides.mjs",
    "slides:export:video": "node scripts/export-social-slides.mjs --video",
    "youtube:export": "node scripts/export-youtube-assets.mjs",
    "social:export": "node scripts/export-promo-assets.mjs",
    "social:manifest": "node scripts/generate-social-render-manifest.mjs",
    "slides:check": "node scripts/validate-slide-layout.mjs",
    "slides:video-check": "node scripts/validate-video-download.mjs",
    "quality:build": "npm test && npm run validate",
    "quality:gate": "node scripts/quality-gate.mjs",
    "attendees:browser-check": "node scripts/validate-attendees.mjs",
    "dinner:browser-check": "node scripts/validate-dinner.mjs",
    "announcements:browser-check": "node scripts/validate-announcements.mjs",
    "start": "gustwind --develop --port 3000",
    "serve": "gustwind --serve --port 3000 --input ./build",
    "test": "npm run worker:test-build && node --test --test-timeout=180000",
    "test:prepare": "wrangler deploy scripts/test-worker/index.mjs --dry-run --outdir .cache/test-worker",
    "types:check": "tsc --noEmit",
    "types:generate": "wrangler types worker-configuration.d.ts",
    "validate": "npm run data:validate && gustwind --validate --input ./build",
    "worker:build": "npm run data:validate && npm run types:check && npm run build:clean && node scripts/verify-build-output.mjs",
    "worker:test-build": "npm run worker:build && npm run test:prepare",
    "worker:build:incremental": "npm run data:validate && npm run types:check && npm run build && node scripts/verify-build-output.mjs",
    "worker:dev": "npm run dev:env && npm run worker:build:incremental && wrangler dev",
    "deploy": "npm run quality:build && npm run db:migrate:remote && wrangler deploy",
    "deploy:checked": "node scripts/verify-build-output.mjs && npm run db:migrate:remote && wrangler deploy",
    "event:build": "node scripts/generate-event-feed.mjs",
    "email:export": "node scripts/export-email-assets.mjs",
    "badges:browser-check": "node scripts/validate-badges.mjs",
    "speaker-slides:browser-check": "node scripts/validate-speaker-slides.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@tailwindcss/typography": "0.5.19",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "entities": "8.1.0",
    "fflate": "0.8.2",
    "gustwind": "0.131.0",
    "marked": "18.0.2",
    "parse5": "8.0.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "axe-core": "4.12.1",
    "dotenv": "17.4.2",
    "miniflare": "5.20261006.1-alpha",
    "playwright": "1.63.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@cloudflare/puppeteer@1.4.0": {
      "@puppeteer/browsers": "3.0.6"
    },
    "ws": "8.21.3"
  }
}
