# Copy to .env for local Worker testing.
#
# Generate a strong value, for example:
# openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=replace-with-local-development-secret

# Optional locally. If left empty, the Worker skips Turnstile verification.
TURNSTILE_SECRET_KEY=

# Optional locally. If left empty, the form hides the Turnstile widget.
TURNSTILE_SITE_KEY=

# Expected hostnames returned by Turnstile when local verification is enabled.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Optional locally. Required to verify controlled Stream webhook tests.
STREAM_WEBHOOK_SECRET=

# Optional locally. Set to true to show the legacy registration interest form.
SHOW_INTEREST_FORM=

# Required for /admin/ locally and in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-local-admin-password
